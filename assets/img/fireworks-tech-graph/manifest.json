  "svg_validator": {
    "script": "scripts/validate_svg.py",
    "entry": "scripts/validate-svg.sh",
    "checks": [
      "XML AST parsing",
      "marker-start/mid/end integrity",
      "path vs component collision detection",
      "absolute vs relative path distinction",
      "group transform nesting effects",
      "curve path sampling (Q/C/S/T)"
    ],
    "test_suite": "tests/test_validate_svg.py"
  },

  "visual_review_gate": {
    "png_readback": true,
    "checks": [
      "clipping detection",
      "label overlap",
      "hierarchy order",
      "whitespace quality",
      "routing quality"
    ],
    "graceful_degradation": "visual_review: skipped (image reader unavailable)",
    "final_status": ["validation: passed", "visual_review: passed"],
    "max_correction_passes": 2
  },

  "loop_engineering": {
    "pipeline": [
      "Prompt",
      "Diagram Contract",
      "Semantic IR",
      "Style Spec",
      "Route Planner",
      "SVG Build",
      "Structural Validation",
      "PNG Visual Readback",
      "Targeted Revision",
      "Verified SVG + PNG"
    ],
    "design_principles": [
      "Evaluate, don't assert — completion backed by validator + render evidence",
      "Deterministic checks first — XML/marker/path/collision/renderability before visual",
      "Perceptual validation second — PNG readback for clipping/overlap/ hierarchy/whitespace/routing",
      "Targeted correction — each pass fixes only diagnosed issues",
      "Bounded convergence — max 2 correction passes by default"
    ]
  },

