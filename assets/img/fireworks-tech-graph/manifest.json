  "png_renderer_comparison": [
    {"renderer": "cairosvg", "quality": "good", "install": "pip install cairosvg", "css_support": true, "recommended": true, "use_when": "Default — best balance"},
    {"renderer": "rsvg-convert", "quality": "fair", "install": "brew install librsvg / apt install librsvg2-bin", "css_support": false, "recommended": false, "use_when": "No Python, simple flat diagrams"},
    {"renderer": "puppeteer", "quality": "best", "install": "npm install puppeteer", "css_support": true, "recommended": false, "use_when": "Browser-generated SVG (D3/Mermaid), pixel-perfect required"}
  ],

  "troubleshooting": [
    {"symptom": "PNG 空白或全黑", "cause": "@import url() 外部字体无法获取", "fix": "移除 @import，使用系统字体栈"},
    {"symptom": "PNG 未生成", "cause": "无渲染器", "fix": "pip install cairosvg"},
    {"symptom": "边框或文字缺失", "cause": "rsvg-convert 不支持 CSS/foreignObject", "fix": "换 cairosvg"},
    {"symptom": "图被底部截断", "cause": "viewBox 高度不够", "fix": "增大 viewBox height"},
    {"symptom": "文字溢出框", "cause": "标签过长", "fix": "加 text-anchor=middle + clipPath 或缩短标签"},
    {"symptom": "图标不渲染", "cause": "外部 CDN URL", "fix": "用 references/icons.md 中的内联 SVG path"}
  ],

