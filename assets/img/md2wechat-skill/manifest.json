{
  "name": "md2wechat-skill",
  "version": "1.0.0",
  "source": "https://github.com/geekjourneyx/md2wechat-skill",
  "description": "面向 AI Agent 的微信公众号创作与发布 CLI，支持 Markdown 转微信 HTML、封面图生成、多账号发布",
  "category": "效率工具",
  "style": "redswiss",
  "license": "Source Available",
  "language": "Go",
  "created_at": "2026-07-11",
  
  "assets": {
    "readme-header.gif": {
      "type": "demo",
      "description": "CLI 演示动画"
    },
    "wechat.png": {
      "type": "qrcode",
      "description": "公众号二维码"
    },
    "theme-showcase": {
      "type": "gallery",
      "description": "主题展示截图",
      "items": [
        "theme-showcase-default.png",
        "theme-showcase-bytedance.png",
        "theme-showcase-elegant-gold.png"
      ]
    }
  },

  "core_features": [
    "Markdown 转微信公众号兼容 HTML",
    "发布前检查 (inspect/doctor)",
    "48 个专业主题 + 43 个高级排版模块",
    "Agent discovery 命令 (capabilities, themes, layout 等)",
    "封面图/信息图生成",
    "多公众号账号管理",
    "AI 去痕写作 (humanize)"
  ],

  "agent_commands": [
    "capabilities --json",
    "doctor --json",
    "inspect article.md --json",
    "themes list --json",
    "layout list --json",
    "layout show <name> --json",
    "layout validate --file article.md --json",
    "title suggest article.md --json",
    "skills list --json",
    "skills read md2wechat --json"
  ],

  "common_commands": [
    "inspect - 检查文章元数据和发布就绪性",
    "advise - 为已有文章推荐可选增强动作",
    "preview - 本地预览",
    "convert - Markdown 转微信 HTML",
    "write - 从想法生成文章",
    "humanize - 重写 AI 文章",
    "generate_cover - 生成封面图",
    "generate_infographic - 生成信息图",
    "upload_image - 上传图片到微信素材库",
    "config wechat-accounts - 查看多账号配置",
    "doctor - 本地配置体检"
  ],

  "api_modes": {
    "free_ai": {
      "themes": 3,
      "modules": 0,
      "output": "prompt for external LLM"
    },
    "pro_api": {
      "themes": 48,
      "modules": 43,
      "output": "deterministic HTML"
    }
  },

  "supported_agents": [
    "Claude Code",
    "Codex",
    "WorkBuddy",
    "Kimi Work",
    "Hermes Agent",
    "OpenClaw"
  ],

  "documentation": [
    "QUICKSTART.md",
    "USAGE.md",
    "DISCOVERY.md",
    "ADVISE.md",
    "LAYOUT.md",
    "HUMANIZE.md",
    "AGENT_IMAGE_GEN.md",
    "CONFIG.md",
    "FAQ.md",
    "TROUBLESHOOTING.md"
  ]
}
