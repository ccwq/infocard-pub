{
  "contract_version": "1.0.0",
  "state_schema": "run-state@1",
  "quality_levels": ["Blocker", "Major", "Advisory"],
  "task_modes": ["create", "update", "rebuild", "repair", "publish"],
  "delivery_modes": ["preview", "direct", "delegated"],
  "reference_policy": {
    "root": ".agents/skills-cop",
    "rules": [
      {"prefix": "infocard/infocard-core-contract/references/", "kind": "standards", "status": "active", "default_load": true, "scope": "layered infocard architecture", "trigger": "core stage contract is loaded", "updated": "2026-08-31", "replacement": null},
      {"pattern": "(^|/)([0-9]{4}[-0-9]*|.*(session|incident|pitfall|postmortem|recovery|lesson|note).*)\\.md$", "kind": "archive", "status": "archive", "default_load": false, "scope": "historical or incident evidence", "trigger": "explicit incident match only", "updated": "2026-08-31", "replacement": null},
      {"pattern": "(^|/).*(example|case|pattern|playbook|recipe|template).*\\.md$", "kind": "examples", "status": "example", "default_load": false, "scope": "task-matched examples", "trigger": "current task matches the example", "updated": "2026-08-31", "replacement": null},
      {"pattern": ".*", "kind": "standards", "status": "active", "default_load": false, "scope": "owning Skill only", "trigger": "owning Skill explicitly names the reference", "updated": "2026-08-31", "replacement": null}
    ]
  },
  "compatibility_contract": {
    "id": "legacy-adapter@1",
    "trigger": "legacy skill name is explicitly invoked",
    "non_trigger": "new orchestrated run unless compatibility is requested",
    "required_inputs": ["legacy request"],
    "optional_inputs": ["existing artifact", "authorization"],
    "structured_output": ["status", "summary", "artifacts", "issues", "next", "replacement"],
    "pre": ["infocard-core-contract"],
    "post": ["replacement route"],
    "success": "legacy semantics are preserved without broader authority",
    "recoverable_errors": ["missing optional legacy detail"],
    "blocking_errors": ["missing replacement", "unavailable project skill"],
    "allowed_references": ["standards", "examples when task-matched"],
    "archive_default_load": false
  },
  "layers": ["entry", "domain", "production", "theme", "assurance", "specialist", "delivery"],
  "skills": [
    {"name":"infocard-core-contract","layer":"entry","trigger":"contract or stage protocol is needed","inputs":["request"],"outputs":["run-state schema"],"success":"schema and failure protocol are available","next":["infocard-orchestrator"]},
    {"name":"infocard-orchestrator","layer":"entry","trigger":"any infocard create, query, update, repair or publish request","inputs":["request","optional existing card"],"outputs":["run plan","stage state"],"success":"correct minimal route and authorization boundary are recorded","next":["infocard-source-and-content","infocard-quality-gate","infocard-publish-pipeline"]},
    {"name":"infocard-source-and-content","layer":"domain","trigger":"content, source or evidence modeling is required","inputs":["request","sources"],"outputs":["content pack"],"success":"claims, disputes, assets and outline are traceable","next":["infocard-card-authoring"]},
    {"name":"infocard-card-authoring","layer":"production","trigger":"an infocard artifact must be created or changed","inputs":["content pack","theme decision"],"outputs":["draft artifact"],"success":"HTML and sidecar remain within .docs until promotion","next":["infocard-theme-contract","infocard-quality-gate"]},
    {"name":"infocard-theme-contract","layer":"theme","trigger":"a theme must be selected or applied","inputs":["content capabilities","theme id"],"outputs":["theme decision","tokens","adapter result"],"success":"selected theme satisfies versioned contract","next":["infocard-quality-gate"],"adapter":{"contract":"infocard-theme-contract@1"}},
    {"name":"infocard-quality-gate","layer":"assurance","trigger":"an artifact needs desktop, mobile, readability or evidence acceptance","inputs":["draft artifact","theme contract","source pack"],"outputs":["quality report"],"success":"single disposition with blocker/major/advisory issues and evidence","next":["debug-*","infocard-publish-pipeline"]},
    {"name":"infocard-publish-pipeline","layer":"delivery","trigger":"preview or authorized publication is requested","inputs":["accepted artifact","quality report","delivery authorization"],"outputs":["preview or delivery result"],"success":"mode-specific side effects and smoke checks are complete","next":["infocard-publish-closeout"]}
  ],
