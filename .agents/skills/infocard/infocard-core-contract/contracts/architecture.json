{
  "contract_version": "2.0.0",
  "state_schema": "router-author-publish@1",
  "quality_levels": ["Critical", "Major", "Minor"],
  "task_modes": ["create", "update", "rebuild", "repair", "publish"],
  "delivery_modes": ["preview", "direct", "delegated"],
  "reference_policy": {
    "root": ".agents/skills-cop",
    "rules": [
      {"prefix": "infocard/infocard-core-contract/references/", "kind": "standards", "status": "active", "default_load": false, "scope": "Router/Author/Publish contract detail", "trigger": "current task needs the named contract detail", "updated": "2026-08-31", "replacement": null},
      {"pattern": "(^|/)([0-9]{4}[-0-9]*|.*(session|incident|pitfall|postmortem|recovery|lesson|note).*)\\.md$", "kind": "archive", "status": "archive", "default_load": false, "scope": "historical or incident evidence", "trigger": "explicit incident match only", "updated": "2026-08-31", "replacement": null},
      {"pattern": "(^|/).*(example|case|pattern|playbook|recipe|template).*\\.md$", "kind": "examples", "status": "example", "default_load": false, "scope": "task-matched examples", "trigger": "current task matches the example", "updated": "2026-08-31", "replacement": null},
      {"pattern": ".*", "kind": "archive", "status": "archive", "default_load": false, "scope": "unclassified historical reference", "trigger": "Router explicitly matches the current task to this reference", "updated": "2026-08-31", "replacement": null}
    ]
  },
  "compatibility_contract": {
    "id": "legacy-adapter@1",
    "trigger": "legacy skill name is explicitly invoked",
    "non_trigger": "new orchestrated run unless compatibility is requested",
    "required_inputs": ["legacy request"],
    "optional_inputs": ["existing artifact", "authorization"],
    "structured_output": ["status", "summary", "artifacts", "issues", "next", "replacement"],
    "pre": ["infocard-router"],
    "post": ["replacement route"],
    "success": "legacy semantics are preserved without broader authority",
    "recoverable_errors": ["missing optional legacy detail"],
    "blocking_errors": ["missing replacement", "unavailable project skill"],
    "allowed_references": ["standards", "examples when task-matched"],
    "archive_default_load": false
  },
  "layers": ["entry"],
  "skills": [
    {"name":"infocard-router","layer":"entry","trigger":"any infocard request","inputs":["request","optional existing card"],"outputs":["minimal route","stage state"],"success":"request is routed to Author or Publish with authority preserved","next":["infocard-author","infocard-publish"]},
    {"name":"infocard-author","layer":"entry","trigger":"a routed artifact must be created or changed","inputs":["routed request","sources","theme decision"],"outputs":[".docs draft","promotion manifest"],"success":"traceable candidate is ready for visual review","next":["infocard-publish"]},
    {"name":"infocard-publish","layer":"entry","trigger":"preview or authorized publication is requested","inputs":["artifact","manifest","visual evidence","delivery authorization"],"outputs":["delivery result","rollback reference"],"success":"critical defects block and final human-review state is explicit","next":[]}
